# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Node
node_modules/

# Foundry build output
**/out/
**/cache/
**/broadcast/

# Generated by a pipeline run. These carry absolute paths from the machine
# that produced them, so they are regenerated rather than committed.
outputs/
*.pkl
*.inv.gz
*.dtrace
*.decls
*.iteration_*.v*.txt
*.strategies.json

# Nested git repositories. Git records these as submodule pointers rather
# than files, so their contents would not reach a clone anyway.
artifacts/
dynamate-sol/dynamate-sol/ginpink-sol/antlr3/
dynamate-sol/dynamate-sol/ginpink-sol/docs/

# Editor and OS
.vscode/
.idea/
.DS_Store
*.swp
*.zip
